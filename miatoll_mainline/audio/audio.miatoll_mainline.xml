<audiohal>
    <mixer card="0">
		<init>
            <!-- Speaker -->
            <ctl name="ASI1 Sel" val="LeftRightDiv2"/>
            <ctl name="Digital Volume Control" val="109"/>
        </init>
    </mixer>
    <device name="speaker">
        <path name="on">
        </path>
        <path name="off">
        </path>
        <path name="pcm_on">
            <ctl name="TERT_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="TERT_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <stream type="pcm" dir="out" card="0" device="0">
        <enable path="pcm_on"/>
        <disable path="pcm_off"/>
    </stream>
</audiohal>
